SUPABASE_URL=https://ijnqccqyqcxqjgglqwzg.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_AUTH_TIMEOUT_SECONDS=5

# AI provider (Phase 5A). Optional as a group: with no key the service still
# starts and serves auth and catalogue, and only the AI path is refused.
# Google AI Studio key. Vertex AI uses different credentials and is not
# reachable by changing GEMINI_BASE_URL alone.
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# Reasoning tokens per call. Zero suits requirement extraction. Only
# 2.5-series models accept this setting.
GEMINI_THINKING_BUDGET=0
# Room preview images (Phase 8, text-to-room). Separate model family.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_IMAGE_TIMEOUT_SECONDS=90
# Hosts the server may fetch product photos from, comma-separated. The
# Supabase project host is always allowed in addition.
IMAGE_REFERENCE_HOSTS=images.unsplash.com

# Cost controls for the paid AI endpoints, per signed-in user. A refused
# request gets 429 with Retry-After and never reaches the model.
RATE_LIMIT_SEARCH_PER_MINUTE=20
RATE_LIMIT_ROOM_PLAN_PER_MINUTE=10
RATE_LIMIT_ROOM_IMAGE_PER_HOUR=20
# How long a parsed sentence or a rendered preview is reused. 0 turns it off.
AI_CACHE_TTL_SECONDS=900

# DEBUG, INFO, WARNING or ERROR. Request lines are logged at INFO.
LOG_LEVEL=INFO
